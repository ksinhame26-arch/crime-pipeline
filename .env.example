# Copy this file to ".env" (same folder) and fill in real values.
# .env is in .gitignore - never commit it.

# Socrata (data.cambridgema.gov) app token
SOCRATA_APP_TOKEN=paste_your_app_token_here

# Pipeline database (postgres_cpd)
POSTGRES_USER=cpd_user
POSTGRES_PASSWORD=change_me_strong_password
# Used when running Python on the laptop directly (Docker maps 5433 -> 5432)
DB_HOST=localhost
DB_PORT=5433

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_too

# Metabase application database
METABASE_DB_USER=metabase_user
METABASE_DB_PASSWORD=change_me_three

# Prefect: self-hosted server from docker-compose (UI at http://localhost:4200)
# Used when running Python on the laptop directly:
PREFECT_API_URL=http://localhost:4200/api
# Optional - to use Prefect Cloud instead, set these two:
# PREFECT_API_URL_DOCKER=https://api.prefect.cloud/api/accounts/<ACCOUNT_ID>/workspaces/<WORKSPACE_ID>
# PREFECT_API_KEY=pnu_xxx

# Metabase admin login (used by deploy/metabase_bootstrap.py)
METABASE_ADMIN_EMAIL=you@example.com
METABASE_ADMIN_PASSWORD=change_me_four

# Schedule (daily at midnight IST by default)
ETL_CRON=0 0 * * *
ETL_TIMEZONE=Asia/Kolkata
# Deployment name shown in the Prefect UI (laptop vs cloud VM)
DEPLOYMENT_NAME=cpd-pipeline-laptop
